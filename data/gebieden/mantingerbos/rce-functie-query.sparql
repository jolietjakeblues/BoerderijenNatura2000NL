PREFIX ceo: <https://linkeddata.cultureelerfgoed.nl/def/ceo#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
SELECT DISTINCT ?rm ?rmnr ?fNaam WHERE {
  VALUES ?rm { <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/10637> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/11184> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/15206> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/28085> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/32797> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/32928> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/37647> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/37822> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/39598> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/40788> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/42426> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/43497> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/45546> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/51965> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/56900> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/56963> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/58021> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/59557> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/61090> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/61438> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/62229> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/62371> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/71631> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/74404> }
  ?rm ceo:rijksmonumentnummer ?rmnr .
  ?rm ceo:heeftOorspronkelijkeFunctie ?fObj .
  ?fObj ceo:heeftFunctieNaam ?fC .
  ?fC skos:prefLabel ?fNaam .
  FILTER(lang(?fNaam) = "nl")
}