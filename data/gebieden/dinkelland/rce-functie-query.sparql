PREFIX ceo: <https://linkeddata.cultureelerfgoed.nl/def/ceo#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
SELECT DISTINCT ?rm ?rmnr ?fNaam WHERE {
  VALUES ?rm { <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/11040> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/15278> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/22891> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/23768> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/25111> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/25839> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/26951> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/28984> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/40009> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/41201> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/42011> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/42294> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/43664> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/45204> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/48172> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/49405> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/53645> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/54366> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/54864> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/56909> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/58755> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/59809> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/65317> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/66354> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/66355> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/66356> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/74560> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/74572> }
  ?rm ceo:rijksmonumentnummer ?rmnr .
  ?rm ceo:heeftOorspronkelijkeFunctie ?fObj .
  ?fObj ceo:heeftFunctieNaam ?fC .
  ?fC skos:prefLabel ?fNaam .
  FILTER(lang(?fNaam) = "nl")
}