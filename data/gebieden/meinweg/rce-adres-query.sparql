PREFIX ceo: <https://linkeddata.cultureelerfgoed.nl/def/ceo#>
SELECT DISTINCT ?rm ?openbareRuimte ?huisnummer ?postcode ?woonplaats WHERE {
  VALUES ?rm { <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/12418> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/23628> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/24459> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/26174> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/38455> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/43122> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/43229> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/48493> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/49134> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/56148> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/57515> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/62077> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/68927> }
  ?rm ceo:heeftBasisregistratieRelatie ?br .
  ?br ceo:heeftBAGRelatie ?bag .
  OPTIONAL { ?bag ceo:openbareRuimte ?openbareRuimte }
  OPTIONAL { ?bag ceo:huisnummer ?huisnummer }
  OPTIONAL { ?bag ceo:postcode ?postcode }
  OPTIONAL { ?bag ceo:woonplaatsnaam ?woonplaats }
}