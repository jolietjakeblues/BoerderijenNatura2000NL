PREFIX ceo: <https://linkeddata.cultureelerfgoed.nl/def/ceo#>
SELECT DISTINCT ?rm ?openbareRuimte ?huisnummer ?postcode ?woonplaats WHERE {
  VALUES ?rm { <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/17726> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/33696> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/42807> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/48499> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/49003> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/58824> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/77530> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/77531> }
  ?rm ceo:heeftBasisregistratieRelatie ?br .
  ?br ceo:heeftBAGRelatie ?bag .
  OPTIONAL { ?bag ceo:openbareRuimte ?openbareRuimte }
  OPTIONAL { ?bag ceo:huisnummer ?huisnummer }
  OPTIONAL { ?bag ceo:postcode ?postcode }
  OPTIONAL { ?bag ceo:woonplaatsnaam ?woonplaats }
}