PREFIX ceo: <https://linkeddata.cultureelerfgoed.nl/def/ceo#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
SELECT DISTINCT ?rm ?rmnr ?fNaam WHERE {
  VALUES ?rm { <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/10359> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/11053> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/13910> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/14997> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/19434> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/24904> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/26240> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/30717> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/37167> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/38416> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/45347> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/47075> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/48064> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/50650> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/52092> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/52827> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/52868> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/53625> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/54414> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/60146> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/70222> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/71919> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/72434> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/77280> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/77281> }
  ?rm ceo:rijksmonumentnummer ?rmnr .
  ?rm ceo:heeftOorspronkelijkeFunctie ?fObj .
  ?fObj ceo:heeftFunctieNaam ?fC .
  ?fC skos:prefLabel ?fNaam .
  FILTER(lang(?fNaam) = "nl")
}