PREFIX ceo: <https://linkeddata.cultureelerfgoed.nl/def/ceo#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
SELECT DISTINCT ?rm ?rmnr ?fNaam WHERE {
  VALUES ?rm { <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/11258> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/22389> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/31053> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/37530> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/44541> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/45387> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/46461> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/55268> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/70823> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/70825> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/70826> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/71608> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/77955> }
  ?rm ceo:rijksmonumentnummer ?rmnr .
  ?rm ceo:heeftOorspronkelijkeFunctie ?fObj .
  ?fObj ceo:heeftFunctieNaam ?fC .
  ?fC skos:prefLabel ?fNaam .
  FILTER(lang(?fNaam) = "nl")
}