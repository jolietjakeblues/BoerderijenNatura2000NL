PREFIX ceo: <https://linkeddata.cultureelerfgoed.nl/def/ceo#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
SELECT DISTINCT ?rm ?rmnr ?fNaam WHERE {
  VALUES ?rm { <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/10085> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/38958> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/47278> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/48457> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/49556> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/51937> }
  ?rm ceo:rijksmonumentnummer ?rmnr .
  ?rm ceo:heeftOorspronkelijkeFunctie ?fObj .
  ?fObj ceo:heeftFunctieNaam ?fC .
  ?fC skos:prefLabel ?fNaam .
  FILTER(lang(?fNaam) = "nl")
}