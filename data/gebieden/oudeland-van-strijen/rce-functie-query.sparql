PREFIX ceo: <https://linkeddata.cultureelerfgoed.nl/def/ceo#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
SELECT DISTINCT ?rm ?rmnr ?fNaam WHERE {
  VALUES ?rm { <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/10722> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/11095> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/11140> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/12922> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/13522> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/15010> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/21710> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/25268> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/28343> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/28548> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/29418> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/29934> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/30864> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/32616> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/35674> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/37459> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/38359> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/39862> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/46524> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/48078> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/49017> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/50362> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/52831> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/53822> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/58128> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/59051> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/68006> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/68183> }
  ?rm ceo:rijksmonumentnummer ?rmnr .
  ?rm ceo:heeftOorspronkelijkeFunctie ?fObj .
  ?fObj ceo:heeftFunctieNaam ?fC .
  ?fC skos:prefLabel ?fNaam .
  FILTER(lang(?fNaam) = "nl")
}