PREFIX ceo: <https://linkeddata.cultureelerfgoed.nl/def/ceo#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
SELECT DISTINCT ?rm ?rmnr ?fNaam WHERE {
  VALUES ?rm { <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/20917> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/31450> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/42693> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/52066> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/55235> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/57446> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/57861> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/60843> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/66269> }
  ?rm ceo:rijksmonumentnummer ?rmnr .
  ?rm ceo:heeftOorspronkelijkeFunctie ?fObj .
  ?fObj ceo:heeftFunctieNaam ?fC .
  ?fC skos:prefLabel ?fNaam .
  FILTER(lang(?fNaam) = "nl")
}