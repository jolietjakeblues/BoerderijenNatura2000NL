PREFIX ceo: <https://linkeddata.cultureelerfgoed.nl/def/ceo#>
SELECT DISTINCT ?rm ?openbareRuimte ?huisnummer ?postcode ?woonplaats WHERE {
  VALUES ?rm { <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/10974> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/37900> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/42693> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/49749> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/52104> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/52809> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/53275> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/53579> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/55235> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/58479> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/61721> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/69021> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/74741> }
  ?rm ceo:heeftBasisregistratieRelatie ?br .
  ?br ceo:heeftBAGRelatie ?bag .
  OPTIONAL { ?bag ceo:openbareRuimte ?openbareRuimte }
  OPTIONAL { ?bag ceo:huisnummer ?huisnummer }
  OPTIONAL { ?bag ceo:postcode ?postcode }
  OPTIONAL { ?bag ceo:woonplaatsnaam ?woonplaats }
}