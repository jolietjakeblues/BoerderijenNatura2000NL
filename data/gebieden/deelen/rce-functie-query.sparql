PREFIX ceo: <https://linkeddata.cultureelerfgoed.nl/def/ceo#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
SELECT DISTINCT ?rm ?rmnr ?fNaam WHERE {
  VALUES ?rm { <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/10807> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/22614> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/26812> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/28588> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/36605> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/37426> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/48452> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/58489> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/77156> }
  ?rm ceo:rijksmonumentnummer ?rmnr .
  ?rm ceo:heeftOorspronkelijkeFunctie ?fObj .
  ?fObj ceo:heeftFunctieNaam ?fC .
  ?fC skos:prefLabel ?fNaam .
  FILTER(lang(?fNaam) = "nl")
}