PREFIX ceo: <https://linkeddata.cultureelerfgoed.nl/def/ceo#>
SELECT DISTINCT ?rm ?openbareRuimte ?huisnummer ?postcode ?woonplaats WHERE {
  VALUES ?rm { <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/11040> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/17383> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/19492> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/22891> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/25111> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/25839> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/26013> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/26951> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/39811> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/40009> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/42011> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/42294> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/43664> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/45204> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/48172> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/53645> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/56909> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/59809> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/65317> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/66354> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/66355> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/66356> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/74560> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/74572> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/75294> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/75295> }
  ?rm ceo:heeftBasisregistratieRelatie ?br .
  ?br ceo:heeftBAGRelatie ?bag .
  OPTIONAL { ?bag ceo:openbareRuimte ?openbareRuimte }
  OPTIONAL { ?bag ceo:huisnummer ?huisnummer }
  OPTIONAL { ?bag ceo:postcode ?postcode }
  OPTIONAL { ?bag ceo:woonplaatsnaam ?woonplaats }
}