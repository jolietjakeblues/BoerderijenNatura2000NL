PREFIX ceo: <https://linkeddata.cultureelerfgoed.nl/def/ceo#>
SELECT DISTINCT ?rm ?openbareRuimte ?huisnummer ?postcode ?woonplaats WHERE {
  VALUES ?rm { <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/19791> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/40606> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/43552> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/49462> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/56092> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/58227> }
  ?rm ceo:heeftBasisregistratieRelatie ?br .
  ?br ceo:heeftBAGRelatie ?bag .
  OPTIONAL { ?bag ceo:openbareRuimte ?openbareRuimte }
  OPTIONAL { ?bag ceo:huisnummer ?huisnummer }
  OPTIONAL { ?bag ceo:postcode ?postcode }
  OPTIONAL { ?bag ceo:woonplaatsnaam ?woonplaats }
}