PREFIX ceo: <https://linkeddata.cultureelerfgoed.nl/def/ceo#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
SELECT DISTINCT ?rm ?rmnr ?fNaam WHERE {
  VALUES ?rm { <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/10813> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/15316> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/16940> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/17058> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/18241> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/20031> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/20471> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/22608> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/22939> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/23163> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/25146> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/26339> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/27422> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/29336> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/29423> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/31884> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/32654> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/34767> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/37759> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/37993> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/40316> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/42344> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/45830> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/47459> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/49700> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/49807> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/51006> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/56501> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/57398> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/59068> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/65650> }
  ?rm ceo:rijksmonumentnummer ?rmnr .
  ?rm ceo:heeftOorspronkelijkeFunctie ?fObj .
  ?fObj ceo:heeftFunctieNaam ?fC .
  ?fC skos:prefLabel ?fNaam .
  FILTER(lang(?fNaam) = "nl")
}