PREFIX ceo: <https://linkeddata.cultureelerfgoed.nl/def/ceo#>
SELECT DISTINCT ?rm ?openbareRuimte ?huisnummer ?postcode ?woonplaats WHERE {
  VALUES ?rm { <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/12245> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/18732> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/21629> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/22153> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/27201> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/32420> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/35437> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/35560> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/42180> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/43527> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/47203> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/54412> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/54999> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/62331> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/74979> }
  ?rm ceo:heeftBasisregistratieRelatie ?br .
  ?br ceo:heeftBAGRelatie ?bag .
  OPTIONAL { ?bag ceo:openbareRuimte ?openbareRuimte }
  OPTIONAL { ?bag ceo:huisnummer ?huisnummer }
  OPTIONAL { ?bag ceo:postcode ?postcode }
  OPTIONAL { ?bag ceo:woonplaatsnaam ?woonplaats }
}