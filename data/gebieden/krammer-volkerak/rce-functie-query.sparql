PREFIX ceo: <https://linkeddata.cultureelerfgoed.nl/def/ceo#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
SELECT DISTINCT ?rm ?rmnr ?fNaam WHERE {
  VALUES ?rm { <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/11114> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/19860> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/23315> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/45816> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/46384> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/46588> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/49916> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/50208> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/51893> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/52473> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/54435> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/59252> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/59982> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/60297> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/71284> }
  ?rm ceo:rijksmonumentnummer ?rmnr .
  ?rm ceo:heeftOorspronkelijkeFunctie ?fObj .
  ?fObj ceo:heeftFunctieNaam ?fC .
  ?fC skos:prefLabel ?fNaam .
  FILTER(lang(?fNaam) = "nl")
}