PREFIX ceo: <https://linkeddata.cultureelerfgoed.nl/def/ceo#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
SELECT DISTINCT ?rm ?rmnr ?fNaam WHERE {
  VALUES ?rm { <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/16473> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/29587> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/35980> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/37483> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/38239> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/41158> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/41170> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/42665> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/44767> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/52815> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/55430> }
  ?rm ceo:rijksmonumentnummer ?rmnr .
  ?rm ceo:heeftOorspronkelijkeFunctie ?fObj .
  ?fObj ceo:heeftFunctieNaam ?fC .
  ?fC skos:prefLabel ?fNaam .
  FILTER(lang(?fNaam) = "nl")
}