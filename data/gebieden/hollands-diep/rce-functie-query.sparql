PREFIX ceo: <https://linkeddata.cultureelerfgoed.nl/def/ceo#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
SELECT DISTINCT ?rm ?rmnr ?fNaam WHERE {
  VALUES ?rm { <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/19860> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/22401> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/25268> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/25592> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/29934> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/31515> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/35674> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/37459> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/38675> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/45816> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/46222> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/50208> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/52473> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/53085> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/54435> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/55005> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/59051> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/68006> }
  ?rm ceo:rijksmonumentnummer ?rmnr .
  ?rm ceo:heeftOorspronkelijkeFunctie ?fObj .
  ?fObj ceo:heeftFunctieNaam ?fC .
  ?fC skos:prefLabel ?fNaam .
  FILTER(lang(?fNaam) = "nl")
}