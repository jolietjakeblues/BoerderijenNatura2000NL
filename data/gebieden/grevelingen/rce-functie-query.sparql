PREFIX ceo: <https://linkeddata.cultureelerfgoed.nl/def/ceo#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
SELECT DISTINCT ?rm ?rmnr ?fNaam WHERE {
  VALUES ?rm { <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/15822> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/23315> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/23370> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/25329> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/28617> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/30424> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/31219> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/33337> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/36607> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/41934> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/42003> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/42095> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/42651> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/45061> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/47158> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/50796> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/54031> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/57552> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/59942> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/59982> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/60318> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/60572> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/60930> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/69137> }
  ?rm ceo:rijksmonumentnummer ?rmnr .
  ?rm ceo:heeftOorspronkelijkeFunctie ?fObj .
  ?fObj ceo:heeftFunctieNaam ?fC .
  ?fC skos:prefLabel ?fNaam .
  FILTER(lang(?fNaam) = "nl")
}