PREFIX ceo: <https://linkeddata.cultureelerfgoed.nl/def/ceo#>
SELECT DISTINCT ?rm ?openbareRuimte ?huisnummer ?postcode ?woonplaats WHERE {
  VALUES ?rm { <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/13236> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/28617> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/30388> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/30424> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/30970> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/36607> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/42095> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/54281> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/55501> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/57552> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/59942> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/60318> }
  ?rm ceo:heeftBasisregistratieRelatie ?br .
  ?br ceo:heeftBAGRelatie ?bag .
  OPTIONAL { ?bag ceo:openbareRuimte ?openbareRuimte }
  OPTIONAL { ?bag ceo:huisnummer ?huisnummer }
  OPTIONAL { ?bag ceo:postcode ?postcode }
  OPTIONAL { ?bag ceo:woonplaatsnaam ?woonplaats }
}