PREFIX ceo: <https://linkeddata.cultureelerfgoed.nl/def/ceo#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
SELECT DISTINCT ?rm ?rmnr ?fNaam WHERE {
  VALUES ?rm { <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/12769> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/19140> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/20482> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/20533> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/22248> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/35771> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/36793> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/37527> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/38732> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/39987> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/40716> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/40997> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/42027> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/45672> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/48365> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/48389> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/50804> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/51317> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/54759> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/55746> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/56583> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/61665> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/65388> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/78416> }
  ?rm ceo:rijksmonumentnummer ?rmnr .
  ?rm ceo:heeftOorspronkelijkeFunctie ?fObj .
  ?fObj ceo:heeftFunctieNaam ?fC .
  ?fC skos:prefLabel ?fNaam .
  FILTER(lang(?fNaam) = "nl")
}