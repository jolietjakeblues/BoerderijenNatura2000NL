PREFIX ceo: <https://linkeddata.cultureelerfgoed.nl/def/ceo#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
SELECT DISTINCT ?rm ?rmnr ?fNaam WHERE {
  VALUES ?rm { <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/18350> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/21844> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/22844> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/25216> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/41211> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/43831> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/44885> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/48958> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/57820> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/60290> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/61239> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/78475> }
  ?rm ceo:rijksmonumentnummer ?rmnr .
  ?rm ceo:heeftOorspronkelijkeFunctie ?fObj .
  ?fObj ceo:heeftFunctieNaam ?fC .
  ?fC skos:prefLabel ?fNaam .
  FILTER(lang(?fNaam) = "nl")
}