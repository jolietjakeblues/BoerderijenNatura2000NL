PREFIX ceo: <https://linkeddata.cultureelerfgoed.nl/def/ceo#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
SELECT DISTINCT ?rm ?rmnr ?fNaam WHERE {
  VALUES ?rm { <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/28085> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/51965> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/56873> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/56963> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/71631> }
  ?rm ceo:rijksmonumentnummer ?rmnr .
  ?rm ceo:heeftOorspronkelijkeFunctie ?fObj .
  ?fObj ceo:heeftFunctieNaam ?fC .
  ?fC skos:prefLabel ?fNaam .
  FILTER(lang(?fNaam) = "nl")
}