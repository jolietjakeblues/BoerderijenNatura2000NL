PREFIX ceo: <https://linkeddata.cultureelerfgoed.nl/def/ceo#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
SELECT DISTINCT ?rm ?rmnr ?fNaam WHERE {
  VALUES ?rm { <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/10974> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/11650> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/16305> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/16411> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/31207> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/31856> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/33616> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/34680> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/36398> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/37900> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/38560> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/45492> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/47422> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/49749> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/52104> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/52809> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/53275> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/53348> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/58924> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/61721> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/62121> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/68213> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/68215> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/68217> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/68218> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/74741> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/75379> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/79608> }
  ?rm ceo:rijksmonumentnummer ?rmnr .
  ?rm ceo:heeftOorspronkelijkeFunctie ?fObj .
  ?fObj ceo:heeftFunctieNaam ?fC .
  ?fC skos:prefLabel ?fNaam .
  FILTER(lang(?fNaam) = "nl")
}