PREFIX ceo: <https://linkeddata.cultureelerfgoed.nl/def/ceo#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
SELECT DISTINCT ?rm ?rmnr ?fNaam WHERE {
  VALUES ?rm { <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/10807> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/12106> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/16785> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/18187> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/26260> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/26812> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/27008> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/28588> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/29436> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/30085> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/31669> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/33312> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/34795> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/35066> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/35534> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/36605> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/36901> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/40941> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/47785> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/51915> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/55162> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/58417> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/58489> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/59835> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/62124> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/62345> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/77156> }
  ?rm ceo:rijksmonumentnummer ?rmnr .
  ?rm ceo:heeftOorspronkelijkeFunctie ?fObj .
  ?fObj ceo:heeftFunctieNaam ?fC .
  ?fC skos:prefLabel ?fNaam .
  FILTER(lang(?fNaam) = "nl")
}