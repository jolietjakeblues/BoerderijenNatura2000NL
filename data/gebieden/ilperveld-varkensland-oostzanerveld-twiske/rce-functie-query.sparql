PREFIX ceo: <https://linkeddata.cultureelerfgoed.nl/def/ceo#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
SELECT DISTINCT ?rm ?rmnr ?fNaam WHERE {
  VALUES ?rm { <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/10666> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/14287> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/14301> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/14343> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/17471> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/20804> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/22113> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/23590> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/23820> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/25220> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/25330> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/26344> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/27095> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/27294> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/33730> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/34221> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/44352> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/45102> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/47326> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/47587> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/48192> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/51133> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/52155> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/52452> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/61763> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/73572> }
  ?rm ceo:rijksmonumentnummer ?rmnr .
  ?rm ceo:heeftOorspronkelijkeFunctie ?fObj .
  ?fObj ceo:heeftFunctieNaam ?fC .
  ?fC skos:prefLabel ?fNaam .
  FILTER(lang(?fNaam) = "nl")
}