PREFIX ceo: <https://linkeddata.cultureelerfgoed.nl/def/ceo#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
SELECT DISTINCT ?rm ?rmnr ?fNaam WHERE {
  VALUES ?rm { <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/10028> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/15833> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/18732> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/22153> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/32420> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/34368> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/35437> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/47203> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/58770> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/62331> }
  ?rm ceo:rijksmonumentnummer ?rmnr .
  ?rm ceo:heeftOorspronkelijkeFunctie ?fObj .
  ?fObj ceo:heeftFunctieNaam ?fC .
  ?fC skos:prefLabel ?fNaam .
  FILTER(lang(?fNaam) = "nl")
}