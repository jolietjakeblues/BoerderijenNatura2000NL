PREFIX ceo: <https://linkeddata.cultureelerfgoed.nl/def/ceo#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
SELECT DISTINCT ?rm ?rmnr ?fNaam WHERE {
  VALUES ?rm { <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/15001> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/18685> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/31312> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/38778> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/43095> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/60164> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/69132> }
  ?rm ceo:rijksmonumentnummer ?rmnr .
  ?rm ceo:heeftOorspronkelijkeFunctie ?fObj .
  ?fObj ceo:heeftFunctieNaam ?fC .
  ?fC skos:prefLabel ?fNaam .
  FILTER(lang(?fNaam) = "nl")
}