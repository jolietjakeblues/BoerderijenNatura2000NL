PREFIX ceo: <https://linkeddata.cultureelerfgoed.nl/def/ceo#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
SELECT DISTINCT ?rm ?rmnr ?fNaam WHERE {
  VALUES ?rm { <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/10085> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/17773> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/18254> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/27154> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/28031> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/29005> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/30229> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/42050> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/44761> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/45777> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/46183> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/49556> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/49817> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/50970> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/51392> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/52329> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/54156> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/54365> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/55403> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/58822> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/58844> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/60494> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/61295> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/61984> }
  ?rm ceo:rijksmonumentnummer ?rmnr .
  ?rm ceo:heeftOorspronkelijkeFunctie ?fObj .
  ?fObj ceo:heeftFunctieNaam ?fC .
  ?fC skos:prefLabel ?fNaam .
  FILTER(lang(?fNaam) = "nl")
}