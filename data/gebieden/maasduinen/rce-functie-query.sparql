PREFIX ceo: <https://linkeddata.cultureelerfgoed.nl/def/ceo#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
SELECT DISTINCT ?rm ?rmnr ?fNaam WHERE {
  VALUES ?rm { <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/11233> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/14413> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/18522> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/19790> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/25877> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/25936> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/27214> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/27460> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/34822> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/36932> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/37333> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/37816> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/45961> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/49478> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/49893> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/51664> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/53827> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/55061> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/57943> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/58178> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/67742> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/69260> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/71363> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/79386> }
  ?rm ceo:rijksmonumentnummer ?rmnr .
  ?rm ceo:heeftOorspronkelijkeFunctie ?fObj .
  ?fObj ceo:heeftFunctieNaam ?fC .
  ?fC skos:prefLabel ?fNaam .
  FILTER(lang(?fNaam) = "nl")
}