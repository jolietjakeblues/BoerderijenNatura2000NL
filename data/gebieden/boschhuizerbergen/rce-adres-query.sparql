PREFIX ceo: <https://linkeddata.cultureelerfgoed.nl/def/ceo#>
SELECT DISTINCT ?rm ?openbareRuimte ?huisnummer ?postcode ?woonplaats WHERE {
  VALUES ?rm { <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/11233> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/11557> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/18522> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/19790> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/29238> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/36932> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/37361> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/41029> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/45961> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/57943> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/69753> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/79386> }
  ?rm ceo:heeftBasisregistratieRelatie ?br .
  ?br ceo:heeftBAGRelatie ?bag .
  OPTIONAL { ?bag ceo:openbareRuimte ?openbareRuimte }
  OPTIONAL { ?bag ceo:huisnummer ?huisnummer }
  OPTIONAL { ?bag ceo:postcode ?postcode }
  OPTIONAL { ?bag ceo:woonplaatsnaam ?woonplaats }
}