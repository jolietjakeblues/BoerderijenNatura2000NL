PREFIX ceo: <https://linkeddata.cultureelerfgoed.nl/def/ceo#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
SELECT DISTINCT ?rm ?rmnr ?fNaam WHERE {
  VALUES ?rm { <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/10550> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/18249> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/23117> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/27681> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/36043> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/51914> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/53968> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/56905> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/58240> }
  ?rm ceo:rijksmonumentnummer ?rmnr .
  ?rm ceo:heeftOorspronkelijkeFunctie ?fObj .
  ?fObj ceo:heeftFunctieNaam ?fC .
  ?fC skos:prefLabel ?fNaam .
  FILTER(lang(?fNaam) = "nl")
}