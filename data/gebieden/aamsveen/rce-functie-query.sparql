PREFIX ceo: <https://linkeddata.cultureelerfgoed.nl/def/ceo#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
SELECT DISTINCT ?rm ?rmnr ?fNaam WHERE {
  VALUES ?rm { <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/15278> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/23768> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/25149> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/41201> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/46937> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/54834> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/55600> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/61500> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/65329> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/65330> <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/65331> }
  ?rm ceo:rijksmonumentnummer ?rmnr .
  ?rm ceo:heeftOorspronkelijkeFunctie ?fObj .
  ?fObj ceo:heeftFunctieNaam ?fC .
  ?fC skos:prefLabel ?fNaam .
  FILTER(lang(?fNaam) = "nl")
}